# ==============================================================================
# Sentix MDR - Frontend .gitignore (Next.js / React / TypeScript / Node)
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build
/dist

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel Deployment
.vercel

# OS & Editor Files
.DS_Store
._*
.idea/
.vscode/
*.swp
*.swo
*~
