# ==============================================================================
# Sentix MDR - Backend .gitignore (Python / FastAPI / SQLite)
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Type Checking Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/

# Databases & Runtime State
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
sentix.db
data_exports/*.jsonl

# Environment Variables & Secrets
.env
.env.*
*.env
*.pem
*.key

# Logs
*.log
logs/

# OS Artifacts
.DS_Store
._*
