# ==============================================================================
# Sentix MDR - Root .gitignore
# Covers Python Backend, Next.js Frontend, Secrets/Env, Databases, and OS Files
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.crt
*.cert

# ------------------------------------------------------------------------------
# Python Bytecode, Caching & Compilation
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Python Testing, Typing & Tooling Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/

# ------------------------------------------------------------------------------
# Python Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Next.js / Node.js Frontend (frontend-next)
# ------------------------------------------------------------------------------
node_modules/
frontend-next/node_modules/
.next/
frontend-next/.next/
out/
frontend-next/out/
frontend-next/build/
frontend-next/dist/
frontend-next/next-env.d.ts
*.tsbuildinfo
.vercel

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Database Files & Telemetry Logs
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/*.db
backend/sentix.db
backend/data_exports/*.jsonl
data_exports/*.jsonl
*.log
logs/

# ------------------------------------------------------------------------------
# OS Artifacts & Editor Temp Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~
*.bak
